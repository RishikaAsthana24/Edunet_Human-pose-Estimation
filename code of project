import numpy as np

def calculate_angle(a, b, c):
    """
    Calculate angle between three points.
    a, b, c are (x, y) coordinates
    """
    a = np.array(a)
    b = np.array(b)
    c = np.array(c)

    ba = a - b
    bc = c - b

    cosine_angle = np.dot(ba, bc) / (np.linalg.norm(ba) * np.linalg.norm(bc))
    angle = np.arccos(cosine_angle)

    return np.degrees(angle)


def get_landmark_coords(landmarks, image_shape, index):
    """
    Convert normalized landmark to pixel coordinates
    """
    h, w, _ = image_shape
    lm = landmarks[index]
    return int(lm.x * w), int(lm.y * h)

// main file

import cv2
import mediapipe as mp
from pose_utils import calculate_angle, get_landmark_coords

# Initialize MediaPipe Pose
mp_pose = mp.solutions.pose
mp_drawing = mp.solutions.drawing_utils

pose = mp_pose.Pose(min_detection_confidence=0.5, min_tracking_confidence=0.5)

# Squat counter variables
counter = 0
stage = None

cap = cv2.VideoCapture(0)

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    # Convert BGR to RGB
    image = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    image.flags.writeable = False

    # Process frame
    results = pose.process(image)

    image.flags.writeable = True
    image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)

    try:
        landmarks = results.pose_landmarks.landmark

        # Get coordinates
        hip = get_landmark_coords(landmarks, image.shape, mp_pose.PoseLandmark.LEFT_HIP.value)
        knee = get_landmark_coords(landmarks, image.shape, mp_pose.PoseLandmark.LEFT_KNEE.value)
        ankle = get_landmark_coords(landmarks, image.shape, mp_pose.PoseLandmark.LEFT_ANKLE.value)

        # Calculate angle
        angle = calculate_angle(hip, knee, ankle)

        # Display angle
        cv2.putText(image, str(int(angle)),
                    knee,
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5, (255, 255, 255), 2)

        # Squat logic
        if angle > 160:
            stage = "up"
        if angle < 90 and stage == "up":
            stage = "down"
            counter += 1

    except:
        pass

    # Draw skeleton
    mp_drawing.draw_landmarks(
        image,
        results.pose_landmarks,
        mp_pose.POSE_CONNECTIONS
    )

    # Display counter
    cv2.rectangle(image, (0, 0), (250, 100), (245, 117, 16), -1)

    cv2.putText(image, 'Squats', (10, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 0), 2)

    cv2.putText(image, str(counter),
                (10, 80),
                cv2.FONT_HERSHEY_SIMPLEX, 2, (255, 255, 255), 2)

    cv2.imshow('Pose Estimation', image)

    if cv2.waitKey(10) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
